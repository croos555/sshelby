{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Sshelby",
  "version": "0.3.0",
  "identifier": "dev.sshelby.app",
  "build": {
    "frontendDist": "../out/web",
    "devUrl": "http://localhost:5174",
    "beforeDevCommand": "npm run web",
    "beforeBuildCommand": "npm run web:build"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Sshelby",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 560,
        "backgroundColor": "#14161d",
        "titleBarStyle": "Overlay",
        "hiddenTitle": true,
        "dragDropEnabled": false,
        "visible": false
      },
      {
        "label": "splash",
        "url": "splash.html",
        "width": 380,
        "height": 400,
        "decorations": false,
        "transparent": true,
        "resizable": false,
        "center": true,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "shadow": false,
        "focus": false,
        "title": "Sshelby"
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src ipc: http://ipc.localhost"
    },
    "macOSPrivateApi": true
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg",
      "nsis",
      "appimage",
      "deb",
      "rpm"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "category": "DeveloperTool",
    "shortDescription": "Local-first SSH client",
    "copyright": "Christophe Roos — MIT"
  }
}
